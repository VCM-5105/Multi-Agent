# ==============================================================================
# Aegis Procure: Environment Configuration
# ==============================================================================

# Oracle Database 26ai Free Connection (Local Docker Container)
ORACLE_USER=system
ORACLE_PASSWORD=AegisProcure2024!
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# LLM Model & API Settings (OpenAI or OpenAI-Compatible: Gemini, Groq, Ollama)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ # Optional: For Gemini
# OPENAI_BASE_URL=http://localhost:11434/v1 # Optional: For local Ollama

# FastMCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio # options: stdio | http
